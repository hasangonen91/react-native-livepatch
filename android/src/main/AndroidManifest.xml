<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Helper activity in its own process: kills the app process and relaunches it
         so the new JS bundle is picked up by the ReactHost (see LivePatchRestartActivity). -->
    <activity
      android:name="com.livepatch.LivePatchRestartActivity"
      android:exported="false"
      android:process=":livepatch_restart"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
  </application>
</manifest>
