{
  "name": "react-native-livepatch",
  "version": "1.0.0",
  "description": "Self-hosted OTA updates for React Native with crash-safe rollback, staged rollouts and a Supabase backend. CodePush alternative.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "livepatch": "./bin/livepatch.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.js"
  },
  "keywords": [
    "react-native",
    "ota",
    "over-the-air",
    "hot-update",
    "code-push",
    "codepush",
    "codepush-alternative",
    "live-update",
    "live-patch",
    "bundle-update",
    "self-hosted",
    "react-native-plugin",
    "supabase",
    "turbomodule",
    "new-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hasangonen91/react-native-livepatch.git"
  },
  "homepage": "https://github.com/hasangonen91/react-native-livepatch#readme",
  "bugs": {
    "url": "https://github.com/hasangonen91/react-native-livepatch/issues"
  },
  "author": "hasangonen91",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native": "^0.87.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib/",
    "src/",
    "cli/",
    "bin/",
    "android/build.gradle",
    "android/src/",
    "ios/",
    "supabase/",
    "react-native-livepatch.podspec",
    "README.md"
  ],
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "engines": {
    "node": ">=18"
  },
  "codegenConfig": {
    "name": "LivePatchSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.livepatch"
    }
  }
}
